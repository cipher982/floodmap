# Docker ignore file - excludes files from Docker build context

# Large data files - mount as volumes to avoid large image size
output/*.mbtiles

# Development files
.git/
.github/
.cursor/
.env
.env.*
.coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
*.pyc
__pycache__/
.DS_Store
.pre-commit-config.yaml

# Debug and temporary files
debug/
debug_*.py
temp_*/
*.tmp
*.log
cache/
data/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Documentation
*.md
docs/

# Test and QA files
tests/
pytest.ini
**/*.test.mjs
**/*.test.js
**/test_*.py
**/*_test.py
**/*_qa.py
**/qa-report.md
tools/map-profiling/
tools/sim_lab/
tools/**/results/
**/node_modules/

# Scripts not needed in container
scripts/
utils/

# Archive data
ARCHIVED_DATA/
srtm_missing_tiles/

# Build artifacts
*.egg-info/
build/
dist/
